---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getContent, homePath, type Lang } from '../lib/i18n';
import { business } from '../lib/business';

interface Props {
  lang: Lang;
  /** Pages that should not appear in search results (the 404 page) */
  noindex?: boolean;
  title?: string;
}
const { lang, noindex = false, title } = Astro.props;
const t = getContent(lang);

const site = Astro.site ?? new URL('https://quadrocoffee.example');
const canonical = new URL(homePath(lang), site).href;
const trUrl = new URL(homePath('tr'), site).href;
const enUrl = new URL(homePath('en'), site).href;
// Link-preview image for WhatsApp, Instagram, Facebook etc. (1200×630). It uses the placeholder hero photo:
// regenerate it once there is a real photo of Quadro (see brief.md).
const ogImage = new URL('/og.jpg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: business.name,
  url: canonical,
  telephone: business.phone,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.street,
    addressLocality: business.city,
    postalCode: business.postalCode,
    addressRegion: business.district,
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng },
  openingHoursSpecification: business.openingHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: [business.instagram, business.facebook].filter(Boolean),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Switch to deck mode before the first paint, so a refresh or deep link doesn't flash the hero first.
         Keep the media query in sync with QUERY in src/scripts/deck.ts. -->
    <script is:inline>
      if (matchMedia('(min-width: 1024px) and (min-height: 620px) and (prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('deck', 'deck-booting');
        // Show the section named in the URL (e.g. #yorumlar) instead of the first one until deck.ts takes over.
        var id = location.hash.slice(1);
        try { id = decodeURIComponent(id); } catch (e) {}
        if (id) {
          var sel = '#' + CSS.escape(id), css = document.createElement('style');
          css.textContent = 'html.deck-booting .panel' + sel + ',html.deck-booting .panel:has(' + sel + '){visibility:visible}'
            + 'html.deck-booting:has(.panel' + sel + ',.panel ' + sel + ') .panel[data-first]{visibility:hidden}';
          document.head.append(css);
        }
      }
    </script>
    <title>{title ?? t.meta.title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={trUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_GB' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#22170F" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Fonts are served from this site (src/styles/fonts.css); preload the title font, used above the fold -->
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">{t.nav.skip}</a>
    <slot />
    <WhatsAppButton lang={lang} />
  </body>
</html>
