---
// Line-drawn cup with rising steam: the hero's floating centrepiece until a product render
// (e.g. an AI-generated drink on a transparent background) replaces it.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg viewBox="0 0 240 220" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" class={`steam-cup ${className}`}>
  <g class="steam">
    <path d="M96 92c-10-12 10-20 0-32s10-20 0-30" />
    <path d="M118 88c-10-12 10-20 0-32s10-20 0-30" />
    <path d="M140 92c-10-12 10-20 0-32s10-20 0-30" />
  </g>
  <path d="M60 110h116v28a52 52 0 0 1-52 52h-12a52 52 0 0 1-52-52z" />
  <path d="M176 120h8a19 19 0 0 1 0 38h-12" />
  <path d="M30 202h180" />
  <path d="M72 128c4 22 18 40 40 46" opacity=".45" />
</svg>

<style>
  .steam path { opacity: 0.85; }
  @media (prefers-reduced-motion: no-preference) {
    .steam path {
      animation: steam 3.6s ease-in-out infinite;
      transform-box: fill-box;
    }
    .steam path:nth-child(2) { animation-delay: -1.2s; }
    .steam path:nth-child(3) { animation-delay: -2.4s; }
  }
  @keyframes steam {
    0% { opacity: 0; translate: 0 14px; }
    35% { opacity: 0.9; }
    100% { opacity: 0; translate: 0 -16px; }
  }
</style>
