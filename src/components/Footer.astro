---
import Panel from './Panel.astro';
import Logo from './Logo.astro';
import { getContent, type Lang } from '../lib/i18n';
import { business } from '../lib/business';

interface Props { lang: Lang; }
const t = getContent(Astro.props.lang);
---
<Panel id="bilgi" as="footer" bg="var(--color-espresso)" prev="var(--color-copper-light)" tone="dark" label="Quadro Coffee" class="items-center text-center text-sm">
  <div data-reveal class="mb-[clamp(24px,6vh,56px)]">
    <div class="float drop-shadow-[0_30px_40px_rgba(0,0,0,0.45)]"><Logo size={240} loading="lazy" class="block h-[clamp(160px,30vh,240px)] w-auto" /></div>
  </div>
  <div data-reveal class="flex flex-wrap justify-center gap-x-14 gap-y-8 text-[#E9E1D6]">
    <div class="flex flex-col gap-1.5">
      <span class="font-semibold text-white">{t.footer.menu}</span>
      <a href="#menu" class="text-[#BFB3A4] hover:text-white">{t.footer.coffee}</a>
      <a href="#menu" class="text-[#BFB3A4] hover:text-white">{t.footer.drinks}</a>
    </div>
    <div class="flex flex-col gap-1.5">
      <span class="font-semibold text-white">{t.footer.visit}</span>
      <span class="text-[#BFB3A4]">{business.district}, {business.city}</span>
      <a href={`tel:${business.phone}`} class="text-[#BFB3A4] hover:text-white">{business.phoneDisplay}</a>
    </div>
    <div class="flex flex-col gap-1.5">
      <span class="font-semibold text-white">{t.footer.follow}</span>
      <a href={business.instagram} class="text-[#BFB3A4] hover:text-white">Instagram</a>
      {business.facebook && <a href={business.facebook} class="text-[#BFB3A4] hover:text-white">Facebook</a>}
    </div>
  </div>
</Panel>
