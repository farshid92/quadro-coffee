---
import Panel from './Panel.astro';
import Logo from './Logo.astro';
import { getContent, type Lang } from '../lib/i18n';
import { business } from '../lib/business';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContent(lang);
// Copyright year: filled in at build time, so it moves on by itself after the first rebuild of a new year
const year = new Date().getFullYear();
// Who made the site (credit line at the very bottom). Change the link to the personal website when it exists.
const maker = { name: 'Farshid Chian', url: 'https://github.com/farshid92' };
---
<Panel id="bilgi" as="footer" bg="var(--color-espresso)" prev="var(--color-cream)" tone="dark" label="Quadro Coffee" class="items-center text-center text-sm">
  <div data-reveal class="mb-[clamp(24px,6vh,56px)]">
    <div class="float drop-shadow-[0_30px_40px_rgba(0,0,0,0.45)]"><Logo size={240} loading="lazy" class="block h-[clamp(160px,30vh,240px)] w-auto" /></div>
  </div>
  <div data-reveal class="flex flex-wrap justify-center gap-x-14 gap-y-8 text-[#E9E1D6]">
    <div class="flex flex-col gap-0.5">
      <span class="font-semibold text-white">{t.footer.menu}</span>
      <a href="#menu" class="inline-flex min-h-[28px] items-center justify-center text-[#BFB3A4] hover:text-white">{t.footer.coffee}</a>
      <a href="#menu" class="inline-flex min-h-[28px] items-center justify-center text-[#BFB3A4] hover:text-white">{t.footer.drinks}</a>
    </div>
    <div class="flex flex-col gap-0.5">
      <span class="font-semibold text-white">{t.footer.visit}</span>
      <span class="text-[#BFB3A4]">{business.district}, {business.city}</span>
      <a href={`tel:${business.phone}`} class="inline-flex min-h-[28px] items-center justify-center text-[#BFB3A4] hover:text-white">{business.phoneDisplay}</a>
    </div>
    <div class="flex flex-col gap-0.5">
      <span class="font-semibold text-white">{t.footer.follow}</span>
      <a href={business.instagram} class="inline-flex min-h-[28px] items-center justify-center text-[#BFB3A4] hover:text-white">Instagram</a>
      {business.facebook && <a href={business.facebook} class="inline-flex min-h-[28px] items-center justify-center text-[#BFB3A4] hover:text-white">Facebook</a>}
    </div>
  </div>
  <div data-reveal class="mt-[clamp(28px,6vh,56px)] w-full max-w-[640px] border-t border-white/10 pt-5 text-xs leading-relaxed text-[#9C8F80]">
    <p>
      <span class="block sm:inline">© {year} Quadro Coffee. {t.footer.rights}</span>
      <span class="hidden sm:inline" aria-hidden="true"> · </span>
      <span class="block sm:inline">{t.footer.madeBy} <a href={maker.url} class="text-[#BFB3A4] underline-offset-4 hover:text-white hover:underline">{maker.name}</a></span>
    </p>
  </div>
</Panel>
