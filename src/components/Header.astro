---
import Logo from './Logo.astro';
import { getContent, homePath, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContent(lang);
const home = homePath(lang);
const link = 'inline-flex min-h-[32px] items-center text-[#E9E1D6] hover:text-white tone-light:text-espresso/80 tone-light:hover:text-espresso';
---
<!-- Normal scroll (phones, tablets): floats over the hero photo with a soft dark fade behind it, and turns
     into a slim solid bar once the page is scrolled.
     Deck mode (desktop): transparent; ink follows the tone of the panel on screen. -->
<header id="site-header" data-deck-chrome class="group fixed inset-x-0 top-0 z-40 text-white transition-[background-color,box-shadow,color] duration-300 data-[scrolled]:bg-espresso/95 data-[scrolled]:shadow-lg tone-light:text-espresso">
  <div class="relative mx-auto flex max-w-[1240px] items-center justify-between gap-3 px-4 py-3 transition-[padding] duration-200 group-data-[scrolled]:py-2 sm:px-6 sm:py-4 deck:max-w-none deck:px-[104px] deck:py-4">
    <a href={home} class="logo no-underline" aria-label="Quadro Coffee">
      <span class="block tone-light:hidden"><Logo /></span>
      <span class="hidden tone-light:block"><Logo variant="dark" loading="lazy" /></span>
    </a>
    <nav aria-label={t.nav.menu} class="nav flex items-center gap-x-[clamp(10px,3.6vw,24px)] whitespace-nowrap text-[13px] font-medium sm:text-sm deck:gap-8 deck:text-xs deck:uppercase deck:tracking-[0.2em]">
      <a href="#menu" class={link}>{t.nav.menu}</a>
      <a href="#aksam" class={link}>{t.nav.events}</a>
      <a href="#iletisim" class={link}>{t.nav.contact}</a>
      <span class="inline-flex items-center text-[13px] font-semibold">
        <a href={homePath('tr')} hreflang="tr" lang="tr" aria-current={lang === 'tr' ? 'page' : undefined}
           class={`inline-flex min-h-[32px] min-w-[24px] items-center justify-center ${lang === 'tr' ? '' : 'opacity-60 hover:opacity-100'}`}>TR</a>
        <span class="opacity-50"> / </span>
        <a href={homePath('en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}
           class={`inline-flex min-h-[32px] min-w-[24px] items-center justify-center ${lang === 'en' ? '' : 'opacity-60 hover:opacity-100'}`}>EN</a>
      </span>
    </nav>
  </div>
</header>

<style>
  /* Logo: smaller on phones, and smaller again once the page is scrolled */
  .logo :global(img) { height: 52px; width: auto; transition: height 0.2s ease; }
  #site-header[data-scrolled] .logo :global(img) { height: 40px; }
  @media (min-width: 640px) {
    .logo :global(img) { height: 72px; }
    #site-header[data-scrolled] .logo :global(img) { height: 56px; }
  }
  :global(html.deck) #site-header .logo :global(img) { height: 64px; }

  /* Over the photo: a soft dark fade behind the header so the links stay readable; gone once scrolled
     (the bar is solid then) and in deck mode */
  #site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% + 56px);
    background: linear-gradient(rgb(34 23 15 / 0.72), rgb(34 23 15 / 0));
    pointer-events: none;
    transition: opacity 0.3s;
  }
  #site-header[data-scrolled]::before,
  :global(html.deck) #site-header::before { opacity: 0; }
  #site-header:not([data-scrolled]) .nav { text-shadow: 0 1px 3px rgb(0 0 0 / 0.45); }
  :global(html.deck) #site-header .nav { text-shadow: none; }
</style>

<script>
  import '../scripts/lang-switch';

  const header = document.getElementById('site-header');
  const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  update();
  window.addEventListener('scroll', update, { passive: true });

</script>
