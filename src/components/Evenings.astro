---
// Evenings panel: a scoreboard for the next match (with a countdown), a gig poster for the next
// live-music night, and a calendar strip of the month. The programme lives in content/events.json.
// Every match, music night and month is rendered once; the script below shows the right ones for
// today's date in Lefkoşa and keeps the countdown running, so the page stays right between rebuilds.
import Panel from './Panel.astro';
import Photo from './Photo.astro';
import { getContent, type Lang } from '../lib/i18n';
import { matches, music, months, matchPhoto, musicPhoto, crest, pick, startOf, longDate, shortDate, monthName, weekdayNames } from '../lib/events';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContent(lang).evenings;

const now = pick(Date.now()); // build-time state; the script updates it in the browser
const left = Math.max(0, now.matchStart - Date.now());
const mins = Math.ceil(left / 6e4);
const clock = [Math.floor(mins / 1440), Math.floor(mins / 60) % 24, mins % 60].map((n) => String(n).padStart(2, '0'));
const weekdays = weekdayNames(lang);

const tv = '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>';
const mic = '<rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4M8 22h8"/>';
const icon = 'h-3.5 w-3.5 fill-none stroke-current stroke-[1.8] [stroke-linecap:round]';
---
<Panel id="aksam" bg="var(--color-espresso)" end="var(--color-hero)" prev="var(--color-cream)" tone="dark" label={t.title} labelledby="evenings-title" class="mx-auto w-full max-w-[1240px]">
  <h2 id="evenings-title" data-reveal="spaced" class="spaced mb-[clamp(20px,4vh,40px)] text-center text-[clamp(40px,4.6vw,64px)] leading-none">{t.title}</h2>

  <div class="grid gap-5 lg:grid-cols-[1fr_1.15fr] lg:gap-6">
    <!-- Scoreboard: the next match, with a countdown to kick-off ("live" during the match) -->
    <div data-reveal class="grid">
      {matches.map((m, i) => (
        <article data-match={i} data-live={i === now.match && now.matchLive ? '' : undefined} hidden={i !== now.match}
                 class="board relative isolate flex flex-col justify-center overflow-hidden rounded-2xl px-5 py-5 text-center sm:px-6">
          {(m.photo ?? matchPhoto) && (
            <Photo file={m.photo ?? matchPhoto} alt={t.matchAlt} width={760} height={420} class="absolute inset-0 -z-10 h-full w-full opacity-25" />
          )}
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[#FFB547]">
            {[m.league, m.tag?.[lang], t.broadcast].filter(Boolean).join(' · ')}
          </p>
          <h3 class="my-4 grid grid-cols-[1fr_auto_1fr] items-center gap-3 font-display font-normal">
            {[m.home, m.away].map((team, side) => (
              <span class={`flex flex-col items-center gap-2.5 ${side ? 'order-3' : ''}`}>
                <i class="block size-[clamp(40px,7vh,54px)] rounded-full ring-[3px] ring-white/85" style={`background:${crest(team)}`}></i>
                <span class="glow text-[clamp(24px,2.6vw,34px)] leading-none tracking-[0.06em] text-[#FFE2A8]">{team}</span>
              </span>
            ))}
            <span class="order-2 text-[clamp(30px,3vw,40px)] text-[#FFB547]">VS</span>
          </h3>
          <div class="clock flex items-start justify-center gap-2.5">
            {clock.map((n, u) => (
              <>
                {u > 0 && <b class="sep font-display text-[clamp(40px,7vh,56px)] font-normal leading-none text-[#FFB547]" aria-hidden="true">:</b>}
                <span class="min-w-[2ch]">
                  <b data-unit={u} class="glow block font-display text-[clamp(40px,7vh,56px)] font-normal leading-none text-[#FFB547] tabular-nums">{n}</b>
                  <small class="block text-[9px] font-semibold uppercase tracking-[0.2em] text-[#BFB3A4]">{t.units[u]}</small>
                </span>
              </>
            ))}
          </div>
          <p class="live-now items-center justify-center gap-2 font-display text-[clamp(36px,6vh,52px)] leading-none tracking-[0.08em] text-[#FFB547]">
            <span class="live-dot" aria-hidden="true"></span>{t.liveNow}
          </p>
          <p class="mt-3 text-[13px] text-[#E9E1D6]">{longDate(lang, m.date)} · {m.time}</p>
        </article>
      ))}
      <p data-match-none hidden={now.match >= 0} class="board grid place-items-center rounded-2xl p-8 text-center text-[#E9E1D6]">{t.noMatch}</p>
    </div>

    <!-- Gig poster: the next live-music night -->
    <div data-reveal class="grid" data-when-labels={JSON.stringify(t.when)}>
      {music.map((e, i) => (
        <article data-music={i} data-when={i === now.music ? now.musicWhen : 'next'} hidden={i !== now.music}
                 class="flex overflow-hidden rounded-2xl bg-copper-light text-espresso shadow-[0_30px_50px_-30px_#000] lg:min-h-[clamp(280px,46vh,420px)]">
          {/* The whole portrait photo, head to knees: a fixed height on phones; on larger screens it is
              as tall as the card, in a half-width frame filled with a soft, dark copy of itself. */}
          {(e.photo ?? musicPhoto)
            ? (
              <div class="relative aspect-[2/5] h-[clamp(300px,92vw,380px)] shrink-0 overflow-hidden bg-[#140b1c] sm:aspect-auto sm:h-auto sm:w-[50%]">
                {/* larger screens: a blurred, darkened copy fills the frame behind the full photo */}
                <Photo file={e.photo ?? musicPhoto} alt="" width={120} height={300} class="absolute inset-0 hidden h-full w-full scale-125 blur-2xl brightness-50 sm:block" />
                <span class="absolute inset-0 hidden bg-[radial-gradient(ellipse_at_center,transparent_35%,rgb(20_11_28/0.85))] sm:block" aria-hidden="true"></span>
                <Photo file={e.photo ?? musicPhoto} alt={`${t.musicAlt}: ${e.name[lang]}`} width={180} height={450} class="photo-fade absolute inset-0 h-full w-full object-top sm:inset-auto sm:top-0 sm:left-1/2 sm:w-auto sm:max-w-none sm:-translate-x-1/2" />
              </div>
            )
            : <div class="spotlight w-[38%] shrink-0" aria-hidden="true"></div>}
          <div class="@container flex min-w-0 flex-1 flex-col justify-center px-4 py-5 sm:px-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em]"><span class="live-dot" aria-hidden="true"></span><span data-when-text>{t.when[i === now.music ? now.musicWhen : 'next']}</span></p>
            <h3 class="my-2.5 font-display text-[clamp(40px,29cqi,76px)] font-normal leading-[0.86]">{e.name[lang]}</h3>
            <p class="font-display text-[clamp(18px,1.75vw,24px)] tracking-[0.06em]">{longDate(lang, e.date)} · <span class="whitespace-nowrap">{e.time}</span></p>
            <p class="mt-1 text-[13px]">{e.text[lang]}</p>
          </div>
        </article>
      ))}
      <p data-music-none hidden={now.music >= 0} class="grid place-items-center rounded-2xl bg-copper-light p-8 text-center text-espresso">{t.noMusic}</p>
    </div>
  </div>

  <!-- Calendar strip: one row of days on desktop, a 7-column month grid on phones -->
  <div data-reveal class="mt-[clamp(16px,3vh,24px)]">
    {months.map(({ ym, days }) => {
      const name = monthName(lang, ym);
      return (
        <div data-month={ym} hidden={ym !== now.month} class="strip grid items-center gap-4 rounded-2xl bg-hero p-4 lg:grid-cols-[auto_1fr_auto]">
          <p class="font-display text-[30px] leading-none tracking-[0.14em] text-copper-light">{t.programme.replace('{month}', name)}</p>
          <div>
            <p class="mb-1.5 grid grid-cols-7 gap-[3px] text-center text-[10px] font-semibold uppercase text-[#BFB3A4] lg:hidden" aria-hidden="true">
              {weekdays.map((w) => <span>{w}</span>)}
            </p>
            <ol class="days grid gap-[3px]" style={`--n:${days.length};--start:${days[0].weekday + 1}`} aria-label={t.calendarLabel.replace('{month}', name)}>
              {days.map((d, i) => {
                const has = d.matches.length + d.music.length > 0;
                const kind = d.matches.length ? 'match' : d.music.length ? 'music' : '';
                const cls = [kind, d.iso < now.today && 'past', d.iso === now.today && 'today'].filter(Boolean).join(' ');
                // Which way the pop-up opens so it stays on screen
                const al = i < 4 ? 'l' : i > days.length - 5 ? 'r' : 'c';
                const am = d.weekday < 2 ? 'l' : d.weekday > 4 ? 'r' : 'c';
                return (
                  <li data-date={d.iso} data-al={al} data-am={am} class={cls} tabindex={has ? 0 : undefined}>
                    <span class="num">{d.day}</span>
                    {has && (
                      <span class="flex gap-0.5" aria-hidden="true">
                        {d.matches.length > 0 && <svg viewBox="0 0 24 24" class={icon} set:html={tv} />}
                        {d.music.length > 0 && <svg viewBox="0 0 24 24" class={icon} set:html={mic} />}
                      </span>
                    )}
                    {has && (
                      <span class="pop" role="tooltip">
                        <b class="today-tag">{t.today} · </b>{shortDate(lang, d.iso)}
                        {d.matches.map((m) => <span class="block">{m.time} · {m.home} – {m.away}</span>)}
                        {d.music.map((e) => <span class="block">{e.time} · {e.name[lang]}</span>)}
                      </span>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
          <p class="flex gap-4 text-[11px] text-[#BFB3A4] lg:flex-col lg:gap-1.5" aria-hidden="true">
            <span class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class={icon} set:html={tv} />{t.match}</span>
            <span class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class={icon} set:html={mic} />{t.music}</span>
          </p>
        </div>
      );
    })}
  </div>
</Panel>

<script>
  import { pick } from '../lib/events';

  const panel = document.getElementById('aksam');
  const pad = (n: number) => String(n).padStart(2, '0');

  const update = () => {
    if (!panel) return;
    const now = Date.now();
    const p = pick(now);

    // Next match, countdown or "live now"
    panel.querySelectorAll<HTMLElement>('[data-match]').forEach((el) => {
      const on = Number(el.dataset.match) === p.match;
      el.hidden = !on;
      el.toggleAttribute('data-live', on && p.matchLive);
    });
    panel.querySelector<HTMLElement>('[data-match-none]')!.hidden = p.match >= 0;
    const left = Math.max(0, p.matchStart - now);
    const mins = Math.ceil(left / 6e4); // round up, so it never reads 00:00:00 before kick-off
    const parts = [Math.floor(mins / 1440), Math.floor(mins / 60) % 24, mins % 60];
    panel.querySelectorAll<HTMLElement>(`[data-match="${p.match}"] [data-unit]`).forEach((el) => {
      el.textContent = pad(parts[Number(el.dataset.unit)]);
    });

    // Next music night and its label (on stage now / tonight / tomorrow / next)
    const labels = JSON.parse(panel.querySelector<HTMLElement>('[data-when-labels]')!.dataset.whenLabels!);
    panel.querySelectorAll<HTMLElement>('[data-music]').forEach((el) => {
      const on = Number(el.dataset.music) === p.music;
      el.hidden = !on;
      if (on) {
        el.dataset.when = p.musicWhen;
        el.querySelector('[data-when-text]')!.textContent = labels[p.musicWhen];
      }
    });
    panel.querySelector<HTMLElement>('[data-music-none]')!.hidden = p.music >= 0;

    // Calendar: the right month, past days dimmed, today outlined
    panel.querySelectorAll<HTMLElement>('[data-month]').forEach((el) => { el.hidden = el.dataset.month !== p.month; });
    panel.querySelectorAll<HTMLElement>('[data-date]').forEach((el) => {
      const d = el.dataset.date!;
      el.classList.toggle('past', d < p.today);
      el.classList.toggle('today', d === p.today);
    });
  };

  update();
  setInterval(update, 30_000);
</script>

<style>
  /* Scoreboard: dark LED board with a dot pattern */
  .board {
    background-color: #0f0b08;
    background-image: radial-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1.2px);
    background-size: 6px 6px;
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 60px rgb(0 0 0 / 0.8), 0 30px 50px -30px #000;
  }
  .glow { text-shadow: 0 0 14px rgb(255 181 71 / 0.6); }
  .live-now { display: none; }
  .board[data-live] .clock { display: none; }
  .board[data-live] .live-now { display: flex; }

  /* Red "live" dot: on the poster only while the night is today */
  .live-dot { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: #E74C3C; vertical-align: middle; }
  [data-when='next'] .live-dot, [data-when='tomorrow'] .live-dot { display: none; }

  /* The photo's left and right edges fade into the dark frame behind it */
  @media (min-width: 640px) {
    :global(.photo-fade) { mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); }
  }

  /* Placeholder art until there is a music photo: a warm stage spotlight */
  .spotlight {
    position: relative; overflow: hidden;
    background:
      radial-gradient(ellipse 60% 90% at 50% -10%, rgb(255 214 150 / 0.8), rgb(192 138 85 / 0.35) 45%, transparent 70%),
      radial-gradient(circle at 50% 120%, #5a3a22, #22170F 70%);
  }
  .spotlight::before {
    content: ''; position: absolute; left: 20%; top: -20%; width: 60%; height: 150%;
    background: linear-gradient(rgb(255 230 180 / 0.35), transparent 80%);
    clip-path: polygon(42% 0, 58% 0, 100% 100%, 0 100%);
    transform-origin: 50% 0;
  }

  /* ---- Calendar ---- */
  .days { grid-template-columns: repeat(7, 1fr); }
  .days li:first-child { grid-column-start: var(--start); }
  @media (min-width: 1024px) {
    .days { grid-template-columns: repeat(var(--n), 1fr); }
    .days li:first-child { grid-column-start: auto; }
  }
  .days li {
    position: relative; height: 54px; border-radius: 6px; padding-top: 6px;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    background: rgb(244 241 236 / 0.05); color: #BFB3A4; font-size: 11px; font-weight: 600;
    outline-offset: 2px;
  }
  .days li.match { background: rgb(169 4 50 / 0.4); color: #fff; }
  .days li.music { background: rgb(192 138 85 / 0.4); color: #fff; }
  .days li.past { opacity: 0.35; }
  .days li.today { box-shadow: inset 0 0 0 2px var(--color-copper-light); }
  .days li[tabindex] { cursor: default; transition: transform 0.2s; }

  /* Pop-up with the day's events: hidden from sight (still read by screen readers) until hover or focus */
  .pop {
    position: absolute; bottom: calc(100% + 8px); z-index: 5; width: max-content; max-width: 240px;
    padding: 8px 11px; border-radius: 8px; background: var(--color-paper); color: var(--color-espresso);
    font-size: 12px; font-weight: 500; line-height: 1.45; text-align: left; white-space: normal;
    box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.7);
    clip-path: inset(50%); opacity: 0; transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .pop > :first-child { font-weight: 700; }
  .today-tag { display: none; }
  .today .today-tag { display: inline; }
  .days li:hover .pop, .days li:focus-visible .pop, .days li:focus .pop { clip-path: none; opacity: 1; transform: none; }
  .days li:hover, .days li:focus-visible { transform: translateY(-3px); z-index: 6; }
  /* --at: 0 = open to the right of the day, 0.5 = centred, 1 = to the left (phones use data-am, desktop data-al) */
  .pop { left: calc(var(--at) * 100%); translate: calc(var(--at) * -100%) 0; }
  [data-am='l'] { --at: 0; } [data-am='c'] { --at: 0.5; } [data-am='r'] { --at: 1; }
  @media (min-width: 1024px) {
    [data-al='l'] { --at: 0; } [data-al='c'] { --at: 0.5; } [data-al='r'] { --at: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sep, .live-dot { animation: blink 1.2s infinite; }
    .spotlight::before { animation: sway 5s ease-in-out infinite alternate; }
  }
  @keyframes blink { 50% { opacity: 0.25; } }
  @keyframes sway { from { transform: rotate(-6deg); } to { transform: rotate(6deg); } }
</style>
