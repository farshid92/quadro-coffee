---
import Panel from './Panel.astro';
import Photo from './Photo.astro';
import { getContent, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const t = getContent(Astro.props.lang);

// Line icons shown until event photos arrive: live music, match night
const icons = [
  '<path d="M36 50V14l34-7v36"/><circle cx="28" cy="50" r="8"/><circle cx="62" cy="43" r="8"/><path d="M36 24l34-7"/>',
  '<rect x="8" y="12" width="64" height="40" rx="3"/><path d="M28 64h24M40 52v12"/><circle cx="40" cy="32" r="9"/><path d="M40 23v4M31.5 29l3.7 1.5M48.5 29l-3.7 1.5M35 40l2.5-3M45 40l-2.5-3"/>',
];
---
<Panel id="aksam" bg="var(--color-espresso)" prev="var(--color-cream)" tone="dark" label={t.evenings.title} labelledby="evenings-title" class="mx-auto w-full max-w-[1240px]">
  <h2 id="evenings-title" data-reveal="spaced" class="spaced mb-[clamp(28px,6vh,64px)] text-center text-[clamp(40px,4.6vw,64px)] leading-none">{t.evenings.title}</h2>
  <ul class="grid gap-10 md:grid-cols-2 md:gap-6">
    {t.evenings.items.map((item, i) => (
      <li data-reveal class="flex flex-col items-center text-center">
        {item.image ? (
          <Photo file={item.image} alt={item.name} width={760} height={480} class="mb-6 h-[clamp(160px,30vh,300px)] w-full rounded-xl" />
        ) : (
          <svg viewBox="0 0 80 72" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true" class="float mb-6 h-[clamp(84px,16vh,150px)] w-auto text-copper" style={`animation-delay:${-i * 1.5}s`} set:html={icons[i % icons.length]} />
        )}
        <h3 class="spaced mb-2 text-[clamp(32px,3.2vw,44px)] leading-none">{item.name}</h3>
        <p class="max-w-[360px] text-[#E9E1D6]">{item.text}</p>
      </li>
    ))}
  </ul>
</Panel>
