---
import Panel from './Panel.astro';
import Photo from './Photo.astro';
import Categories from './Categories.astro';
import { getContent, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContent(lang);
---
<Panel id="menu" bg="var(--color-copper)" end="var(--color-copper-light)" prev="var(--color-hero)" tone="light" label={t.specials.title} labelledby="specials-title" class="mx-auto w-full max-w-[1240px]">
  <h2 id="specials-title" data-reveal="spaced" class="spaced mb-1 text-center text-[clamp(40px,4.6vw,64px)] leading-none">{t.specials.title}</h2>
  <p data-reveal class="mb-[clamp(20px,3.5vh,36px)] text-center text-sm font-medium">{t.specials.subtitle}</p>
  <div data-reveal class="mx-auto mb-[clamp(20px,3.5vh,36px)] w-full max-w-[760px]"><Categories lang={lang} /></div>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {t.specials.items.map((item) => (
      <li data-reveal class="special flex flex-col gap-2 rounded-xl bg-paper p-3 pb-4">
        <div class="relative overflow-hidden rounded-md">
          <Photo file={item.image} alt={item.name} width={600} height={440} class="h-[clamp(120px,19vh,200px)] w-full" />
          {/* Hover effect: steam over hot drinks, sparkles on iced ones */}
          <span class={item.serve === 'iced' ? 'glint' : 'steam'} aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <h3 class="mx-1 mt-1 text-2xl leading-tight">{item.name}</h3>
        <p class="mx-1 text-[13px] text-muted">{item.text}</p>
        <div class="mx-1 mt-auto flex items-center justify-between pt-1">
          <span class="font-bold">{item.price ? `₺${item.price}` : '₺ TODO'}</span>
          <a href="#menu" class="inline-flex min-h-[36px] items-center rounded-md bg-espresso px-3.5 text-[13px] font-semibold text-white hover:bg-black">{t.specials.cta}</a>
        </div>
      </li>
    ))}
  </ul>
  <p data-reveal class="mt-[clamp(16px,3vh,28px)] text-center"><a href="#menu" class="font-semibold underline decoration-1 underline-offset-4 hover:no-underline">{t.specials.allMenu} →</a></p>
</Panel>

<style>
  /* Hover (mouse only): the card lifts, and the drink steams (hot) or sparkles (iced). */
  .special {
    box-shadow: 0 18px 40px -24px rgb(34 23 15 / 0.55);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
  }
  .steam, .glint { position: absolute; opacity: 0; pointer-events: none; transition: opacity 0.4s; }

  /* Steam: three soft white wisps rising from the cup */
  .steam { left: calc(50% - 26px); bottom: 50%; width: 52px; height: 64px; } /* just above the cup rim, over the dark table */
  .steam i {
    position: absolute; bottom: 0; width: 18px; height: 50px; border-radius: 50%;
    background: radial-gradient(ellipse, #fff 0 20%, rgb(255 255 255 / 0.7) 45%, transparent 72%);
    filter: blur(3px);
  }
  .steam i:nth-child(1) { left: 4px; }
  .steam i:nth-child(2) { left: 17px; animation-delay: -0.7s; }
  .steam i:nth-child(3) { left: 30px; animation-delay: -1.4s; }

  /* Sparkles: three small four-point glints on the glass */
  .glint { inset: 0; }
  .glint i {
    position: absolute; width: 14px; height: 14px; opacity: 0;
    background:
      radial-gradient(circle, #fff 0 18%, transparent 20%),
      linear-gradient(#fff, #fff) center / 2px 100% no-repeat,
      linear-gradient(90deg, #fff, #fff) center / 100% 2px no-repeat;
  }
  .glint i:nth-child(1) { left: 42%; top: 30%; }
  .glint i:nth-child(2) { left: 52%; top: 52%; animation-delay: 0.5s; }
  .glint i:nth-child(3) { left: 46%; top: 70%; animation-delay: 1s; }

  @media (hover: hover) {
    .special:hover { transform: translateY(-10px); box-shadow: 0 34px 50px -24px rgb(34 23 15 / 0.7); }
    .special:hover .steam, .special:hover .glint { opacity: 1; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .special:hover .steam i { animation: steam-rise 2.1s ease-in infinite; }
    .special:hover .glint i { animation: glint-twinkle 1.5s ease-in-out infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .special { transition: none; }
  }
  @keyframes steam-rise {
    0% { transform: translateY(10px) scaleX(1); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(-30px) translateX(6px) scaleX(1.8); opacity: 0; }
  }
  @keyframes glint-twinkle {
    0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); }
    50% { opacity: 1; transform: scale(1) rotate(45deg); }
  }
</style>
